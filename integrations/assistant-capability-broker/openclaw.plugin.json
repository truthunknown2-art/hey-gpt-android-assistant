{
  "id": "assistant-capability-broker",
  "name": "Assistant Capability Broker",
  "description": "Durable typed plans and receipts for the agentic assistant.",
  "version": "0.2.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "memoryEnabled": {
        "type": "boolean",
        "default": false
      },
      "memoryAgentId": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
        "default": "voice-main"
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "assistant_memory_remember",
      "assistant_memory_forget"
    ]
  },
  "toolMetadata": {
    "assistant_memory_remember": {
      "optional": true
    },
    "assistant_memory_forget": {
      "optional": true
    }
  }
}
